# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored and will never be committed.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Your Anthropic API key — get one at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# The Odds API key — free tier (500 req/month) at https://the-odds-api.com
# Provides consensus lines from 20+ books. Leave blank to use ESPN odds only.
VITE_ODDS_API_KEY=your-odds-api-key-here
